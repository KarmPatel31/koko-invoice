{
  "name": "koko-invoice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node --watch server/index.js\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules",
    "test": "node --test tests/api.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-koko-security \"node --test tests/firestore.test.js\"",
    "test:pdf": "node tests/pdf-layout.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.20.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.5.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.542.0",
    "multer": "^2.0.2",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2",
    "sharp": "^0.35.4",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.31.0",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0"
  }
}
