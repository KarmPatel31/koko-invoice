rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(companyId) {
      return request.auth != null
        && request.auth.token.kokoAccess == true
        && request.auth.token.companyId == companyId
        && request.auth.token.role in ['owner', 'admin', 'staff', 'viewer']
        && get(/databases/$(database)/documents/_access/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/_access/$(request.auth.uid)).data.companyId == companyId
        && get(/databases/$(database)/documents/_access/$(request.auth.uid)).data.role == request.auth.token.role;
    }
    match /companies/{companyId}/{collectionName}/{document=**} {
      allow read: if member(companyId)
        && collectionName in ['stores', 'invoices', 'quotes', 'tasks'];
      allow write: if member(companyId)
        && request.auth.token.role in ['owner', 'admin', 'staff']
        && collectionName in ['stores', 'invoices', 'quotes', 'tasks'];
    }
    // Membership, billing, usage, legacy shared data, and all other paths are server-only.
  }
}
